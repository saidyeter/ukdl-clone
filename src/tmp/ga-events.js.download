var DVSA=DVSA||{};DVSA.ga=DVSA.ga||{};DVSA.ga.event=(function(){var setup,setupForGoogleAnalytics,splitAction;splitAction=function(action){var parts=action.split(':');if(parts.length<=3)return parts;return[parts.shift(),parts.shift(),parts.join(':')];};setup=function(analyticsCallback){var gaEvents=$('[ga-event]');$.each(gaEvents,function(index,value){var gaEvent=$(value).attr('ga-event');if(gaEvent){analyticsCallback.apply(null,splitAction(gaEvent));}});};setupForGoogleAnalytics=function(){setup(DVSA.ga.sendGoogleAnalyticsEvent);};return{setup:setup,setupForGoogleAnalytics:setupForGoogleAnalytics};}());DVSA.ga.sendGoogleAnalyticsEvent=function(category,event,label){if(window.ga&&typeof(window.ga)==='function'){ga('send','event',category,event,label);}else{_gaq.push(['_trackEvent',category,event,label,undefined,true]);}};